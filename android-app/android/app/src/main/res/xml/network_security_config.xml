<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. The game is bundled locally; no cleartext traffic is allowed. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
