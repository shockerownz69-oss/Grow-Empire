# DO NOT COMMIT THIS FILE WITH REAL VALUES.
# Copy to: android/keystore.properties  (gitignored)
# Then fill in the values from your own keystore (see docs/SIGNING.md).

storeFile=/absolute/path/to/grow-empire-upload.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=grow-empire-upload
keyPassword=YOUR_KEY_PASSWORD
